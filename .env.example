# ===== 复制本文件为 .env 并填写 =====
# cp .env.example .env   （Windows: copy .env.example .env）

# ===== NoneBot2 基础 =====
# 反向 WebSocket 监听地址（NapCat 会主动连接到这里）
HOST=127.0.0.1
PORT=8080
# 超级用户（机器人管理员）QQ 号，JSON 数组；多个用逗号分隔
SUPERUSERS=["10001", "10002"]
# 命令前缀（空字符串表示无需 / 前缀；同时保留 / 兼容）
COMMAND_START=["", "/"]

# ===== 数据库 =====
# 默认 SQLite，路径相对项目根目录
DB_URL=sqlite:///data/bot.db
# 原始训练明细保留天数（超过自动清除；≤0 = 永久保留）
RETENTION_DAYS=365

# ===== 每日运动排行播报（默认每晚 23:00）=====
BROADCAST_HOUR=23
BROADCAST_MINUTE=0
# 显式指定播报群号（JSON 数组）；留空 = 自动播报到机器人出现过的所有群
BROADCAST_GROUPS=[]
# 群使用白名单（JSON 数组）；留空 = 不限制（全群可用）；填群号 = 仅这些群可用
ALLOWED_GROUPS=[]

# ===== 打卡体系 =====
# 打卡计数起点（本学期开学日，YYYY-MM-DD）：此日期之前的记录不统计打卡天数
SEMESTER_START=2026-09-20

# ===== 运动平台（每用户独立绑定，无需在此填账号密码）=====
# 佳明 Garmin：成员私聊机器人「garmin绑定 邮箱 密码」绑定；中国区账号 is_cn=true
GARMIN_IS_CN=true

# 高驰 COROS：成员发「绑定 coros」→ 私聊收到授权链接 → 浏览器授权
COROS_REGION=cn

# ===== 大模型（OpenAI 兼容；可选增强层，留空 = 自动禁用）=====
# 推荐：智谱 GLM-5.3-Flash —— 原生多模态（文本 + 图片）、1M 上下文，
# 约 0.8 元/百万 输入 token、2.8 元/百万 输出 token（本项目低频短输出，月成本约 2 元）
# key 获取：https://bigmodel.cn/usercenter/proj-mgmt/apikeys
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 思考强度（low / medium / max）：GLM-5.3-Flash 的思考常开，设 low 可减少思考 token，
# 避免短文案的 max_tokens 被吃光导致空回复。留空 = 不下发该参数（兼容其它服务商）。
LLM_REASONING_EFFORT=low
# 单次调用读超时（秒）：直连 GLM 建议 20~25；走慢速中转站保持 45
LLM_TIMEOUT=25
# 识图隐私开关：本地 OCR 未识别出距离 / 识别结果可疑时，是否允许把截图发给视觉模型兜底
#（false = 只用本地 OCR，截图绝不上传云端）
LLM_VISION_ENABLED=true

# ===== 模型池故障转移（可选）=====
# 按顺序尝试：主端点失败 → 依次切换下面的备用端点 → 全部失败才降级模板文案。
# JSON 数组；留空 = 只用主端点。api_key 留空的项会被自动跳过。
# 视觉兜底只会路由到 vision=true 的端点，纯文本模型不会被发图。
# 示例 A（本地 Ollama：零成本、无需任何云端 key；先执行 `ollama pull qwen3:4b`）：
# LLM_FALLBACKS=[{"model":"qwen3:4b","base_url":"http://127.0.0.1:11434/v1/chat/completions","api_key":"ollama","timeout":30}]
# 示例 B（第二家云厂商，规避单一供应商故障）：
# LLM_FALLBACKS=[{"model":"qwen-flash","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions","api_key":"你的百炼key"}]
LLM_FALLBACKS=[]
