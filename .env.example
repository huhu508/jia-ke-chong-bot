# ===== 复制本文件为 .env 并填写 =====
# cp .env.example .env   （Windows: copy .env.example .env）

# ===== NoneBot2 基础 =====
# 反向 WebSocket 监听地址（NapCat 会主动连接到这里）
HOST=127.0.0.1
PORT=8080
# 超级用户（机器人管理员）QQ 号，JSON 数组
SUPERUSERS=["10001"]
# 命令前缀（空字符串表示无需 / 前缀；同时保留 / 兼容）
COMMAND_START=["", "/"]

# ===== 数据库 =====
# 默认 SQLite，路径相对项目根目录
DB_URL=sqlite:///data/bot.db

# ===== 周聚合触发时间（每周一）=====
WEEKLY_HOUR=0
WEEKLY_MINUTE=10

# ===== 每日运动排行播报（默认每晚 23:00）=====
BROADCAST_HOUR=23
BROADCAST_MINUTE=0
# 显式指定播报群号（JSON 数组）；留空 = 自动播报到机器人出现过的所有群
BROADCAST_GROUPS=[]

# ===== 运动平台（每用户独立绑定，无需在此填账号密码）=====
# 佳明 Garmin：成员私聊机器人「garmin绑定 邮箱 密码」绑定；中国区账号 is_cn=true
GARMIN_IS_CN=true

# 高驰 COROS：成员发「绑定 coros」→ 私聊收到授权链接 → 浏览器授权
COROS_REGION=cn

# ===== 智谱 GLM 大模型（可选增强层，留空 = 自动禁用「总结」的 AI 润色）=====
# 免费模型 glm-4-flash，低价 glm-4-air；在 open.bigmodel.cn 控制台获取 key
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
