# ===== 复制本文件为 .env 并填写 =====
# cp .env.example .env   （Windows: copy .env.example .env）

# ===== NoneBot2 基础 =====
# 反向 WebSocket 监听地址（NapCat 会主动连接到这里）
HOST=127.0.0.1
PORT=8080
# 超级用户（机器人管理员）QQ 号，JSON 数组；多个用逗号分隔
SUPERUSERS=["10001", "10002"]
# 命令前缀（空字符串表示无需 / 前缀；同时保留 / 兼容）
COMMAND_START=["", "/"]

# ===== 数据库 =====
# 默认 SQLite，路径相对项目根目录
DB_URL=sqlite:///data/bot.db

# ===== 每日运动排行播报（默认每晚 23:00）=====
BROADCAST_HOUR=23
BROADCAST_MINUTE=0
# 显式指定播报群号（JSON 数组）；留空 = 自动播报到机器人出现过的所有群
BROADCAST_GROUPS=[]
# 群使用白名单（JSON 数组）；留空 = 不限制（全群可用）
ALLOWED_GROUPS=[595366460, 1062117913]

# ===== 打卡体系 =====
# 打卡计数起点（本学期开学日，YYYY-MM-DD）：此日期之前的记录不统计打卡天数
SEMESTER_START=2026-09-22

# ===== 运动平台（每用户独立绑定，无需在此填账号密码）=====
# 佳明 Garmin：成员私聊机器人「garmin绑定 邮箱 密码」绑定；中国区账号 is_cn=true
GARMIN_IS_CN=true

# 高驰 COROS：成员发「绑定 coros」→ 私聊收到授权链接 → 浏览器授权
COROS_REGION=cn

# ===== 大模型（Agnes AI，OpenAI 兼容；可选增强层，留空 = 自动禁用）=====
# 在 apihub.agnes-ai.com 获取 key；模型用 3.0-flash（非推理对话模型，快且稳定）
LLM_API_KEY=
LLM_MODEL=agnes-3.0-flash
LLM_BASE_URL=https://apihub.agnes-ai.com/v1/chat/completions
